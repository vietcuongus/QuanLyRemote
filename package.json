{
  "name": "quanlyremote",
  "version": "1.0.0",
  "description": "A fast, polished Windows workspace for SSH, SFTP and remote desktops.",
  "author": "vietcuongus",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/icon.cjs && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "test:portable": "node scripts/portable-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.0",
    "playwright": "^1.58.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "io.vietcuongus.quanlyremote",
    "productName": "QuanLyRemote",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.ico", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": { "artifactName": "${productName}-${version}-${arch}-portable.${ext}" }
  }
}
